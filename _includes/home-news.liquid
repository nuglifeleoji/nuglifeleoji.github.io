<style>
  .home-news {
    clear: both;
    margin: 2.5rem 0 1.5rem;
  }

  .home-news h2 {
    margin: 0 0 1rem;
    font-size: 1.65rem;
    font-weight: 400;
  }

  .home-news-list {
    margin: 0;
    padding-left: 1.5rem;
    font-size: 1rem;
    line-height: 1.8;
  }

  .home-news-list li + li {
    margin-top: 0.55rem;
  }

  .home-news-date {
    white-space: nowrap;
  }

  .home-news-content,
  .home-news-content p {
    display: inline;
    margin: 0;
  }

  .home-news-content a {
    overflow-wrap: anywhere;
  }

  .home-news-empty {
    color: var(--global-text-color-light);
  }

  @media (max-width: 575px) {
    .home-news {
      margin-top: 2rem;
    }

    .home-news h2 {
      font-size: 1.5rem;
    }
  }
</style>

<section class="home-news" id="news" aria-labelledby="news-heading">
  <h2 id="news-heading">News</h2>
  {% assign news_items = site.news | sort: 'date' | reverse %}
  {% if news_items.size > 0 %}
    <ul class="home-news-list">
      {% for item in news_items limit: page.announcements.limit %}
        <li>
          <time class="home-news-date" datetime="{{ item.date | date_to_xmlschema }}">({{ item.date | date: '%b, %Y' }})</time>
          <div class="home-news-content">
            {% if item.inline %}
              {{ item.content | markdownify }}
            {% else %}
              <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="home-news-empty">Updates coming soon.</p>
  {% endif %}
</section>
