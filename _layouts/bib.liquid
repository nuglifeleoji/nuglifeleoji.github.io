---
---
{%- assign paper_url = null -%}
{%- if entry.pdf -%}
  {%- if entry.pdf contains '://' -%}
    {%- assign paper_url = entry.pdf -%}
  {%- else -%}
    {%- assign paper_url = entry.pdf | prepend: '/assets/pdf/' | relative_url -%}
  {%- endif -%}
{%- elsif entry.html -%}
  {%- if entry.html contains '://' -%}
    {%- assign paper_url = entry.html -%}
  {%- else -%}
    {%- assign paper_url = entry.html | prepend: '/assets/html/' | relative_url -%}
  {%- endif -%}
{%- elsif entry.arxiv -%}
  {%- assign paper_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' -%}
{%- endif -%}
{%- assign entry_url = paper_url | default: entry.code -%}

<article id="{{ entry.key }}" class="paper-entry{% unless entry.preview %} paper-entry--text-only{% endunless %}">
  {% if entry.preview %}
    {% assign preview_images = entry.preview | split: ',' %}
    <div class="paper-preview">
      {% if entry_url %}<a href="{{ entry_url }}" aria-label="View {{ entry.title | escape }}">{% endif %}
      {% for preview_image in preview_images %}
        {% assign preview_path = preview_image | strip %}
        {% if preview_path contains '://' %}
          {% assign preview_url = preview_path %}
        {% else %}
          {% assign preview_url = preview_path | prepend: '/assets/img/publication_preview/' | relative_url %}
        {% endif %}
        <img src="{{ preview_url | escape }}" alt="Figure {{ forloop.index }} from {{ entry.title | escape }}" loading="lazy" decoding="async">
      {% endfor %}
      {% if entry_url %}</a>{% endif %}
    </div>
  {% endif %}

  <div class="paper-content">
    <h2 class="paper-title">
      {% if entry_url -%}
        <a href="{{ entry_url }}">{{ entry.title }}</a>
      {%- else -%}
        {{- entry.title -}}
      {%- endif %}
    </h2>

    <div class="paper-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- assign author_is_self = false -%}
        {%- if site.scholar.last_name contains author_last_name -%}
          {%- if site.scholar.first_name contains author.first -%}
            {%- assign author_is_self = true -%}
          {%- endif -%}
        {%- endif -%}
        {%- unless forloop.first -%}, {% endunless -%}
        {%- capture author_name -%}{{ author.first | strip }} {{ author_last_html | strip }}{%- endcapture -%}
        {%- if author_is_self -%}
          <strong>{{ author_name }}</strong>
        {%- else -%}
          {{ author_name }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign proceedings = 'inproceedings,incollection' | split: ',' -%}
    {%- assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' -%}
    {%- capture venue -%}
    {%- if entry.type == 'article' -%}
      {{ entry.journal }}
    {%- elsif proceedings contains entry.type -%}
      {{ entry.booktitle }}
    {%- elsif thesis contains entry.type -%}
      {{ entry.school }}
    {%- endif -%}
  {%- endcapture -%}

    <div class="paper-venue">
      {%- assign venue_text = venue | strip -%}
      {%- assign venue_includes_year = false -%}
      {%- if entry.year and venue_text contains entry.year -%}
        {%- assign venue_includes_year = true -%}
      {%- endif -%}
      {%- if entry.status -%}
        {{ entry.status | escape }}
      {%- elsif venue_text != '' -%}
        {%- assign venue_parts = venue_text | split: '; ' -%}
        {%- for venue_part in venue_parts -%}
          {%- unless forloop.first -%}<br>{%- endunless -%}
          {{ venue_part -}}
        {%- endfor -%}
        {%- if entry.year and venue_includes_year == false -%}
          {%- if venue_text == 'arXiv preprint' %} {{ entry.year }}{% else %}, {{ entry.year }}{% endif -%}
        {%- endif -%}
      {%- elsif entry.year -%}
        {{ entry.year }}
      {%- endif -%}
    </div>

    {%- if entry.note -%}
      <div class="paper-note">{{ entry.note }}</div>
    {%- endif -%}

    <div class="links paper-links">
      {%- if paper_url -%}
        <a href="{{ paper_url }}">paper</a>
      {%- endif -%}
      {%- if entry.code -%}
        <a href="{{ entry.code }}">code</a>
      {%- endif -%}
      {%- if entry.bibtex_show -%}
        <a class="bibtex" href="#{{ entry.key }}-bibtex" aria-controls="{{ entry.key }}-bibtex">bibtex</a>
      {%- endif -%}
      {%- if entry.website -%}
        <a href="{{ entry.website }}">website</a>
      {%- endif -%}
    </div>

    {%- if entry.bibtex_show -%}
      <div id="{{ entry.key }}-bibtex" class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {%- endif -%}
  </div>
</article>
